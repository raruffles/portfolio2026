// Gatilhos de Autoridade e Confiança
const diferenciais = [
  {
    numero: "+10",
    label: "Anos de Mercado",
    sub: "Mais de 3.500 clientes atendidos em SP",
    icone: "clock",
  },
  {
    numero: "40 min",
    label: "Tempo Médio de Chegada",
    sub: "Unidades móveis espalhadas por toda SP",
    icone: "navigation",
  },
  {
    numero: "100%",
    label: "Compromisso e Garantia",
    sub: "Garantia formal por escrito de 90 dias",
    icone: "shield-check",
  },
