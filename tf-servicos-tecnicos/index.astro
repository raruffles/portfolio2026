    titulo: "Desentupimento",
    descricao: "Desobstrução mecânica de pias, ralos, vasos sanitários, esgoto e caixas de gordura sem quebra-quebra.",
    tag: "Sem Danificar Pisos",
    badgeColor: "bg-purple-100 text-purple-900 border-purple-300",
    icon: "activity",
    linkText: "Desentupir Agora",
  },
  {
    id: "pedreiro",
    titulo: "Pedreiro & Alvenaria",
    descricao: "Reformas em geral, reboco, contrapiso, colocação de pisos, porcelanatos, quebra e alvenaria estrutural.",
    tag: "Obras e Reformas",
    badgeColor: "bg-stone-100 text-stone-900 border-stone-300",
    icon: "hammer",
    linkText: "Orçamento de Pedreiro",
  },
  {
    id: "telhadista",
    titulo: "Telhadista & Calhas",
    descricao: "Eliminação imediata de goteiras, troca de telhas quebradas, rufos, calhas e impermeabilização total.",
    tag: "Solução Definitiva",
    badgeColor: "bg-orange-100 text-orange-900 border-orange-300",
    icon: "home",
    linkText: "Consertar Telhado",
  },
];

// Serviços Complementares
const outrosServicos = [
  "Pintura Residencial e Comercial",
  "Construção Civil",
  "Drywall e Gesso Acartonado",
  "Instalação e Manutenção de Ar-Condicionado",
  "Solda e Serralheria",
  "Impermeabilização de Lajes",
];

// Itens de Elétrica (Detalhamento)
const itensEletrica = [
  "Troca de Disjuntores e Barramentos",
  "Instalação Nova Residencial e Comercial",
  "Troca e Redimensionamento de Fiação",
  "Instalação de Interruptores e Tomadas 20A",
  "Aterramento Elétrico e Sistema DPS",
  "Iluminação Técnica, Lustres e Fitas LED",
  "Instalação de Chuveiros e Aquecedores",
  "Quadro de Distribuição (QDC) e Laudos",
];

// Itens de Hidráulica (Detalhamento)
const itensHidraulica = [
  "Detecção e Reparo de Vazamentos Ocultos",
  "Conserto e Troca de Válvula Hydra e Caixas Acopladas",
  "Desentupimento Especializado de Pias e Ralos",
  "Troca de Registros Gerais e Colunas de Prumada",
  "Instalação de Torneiras, Misturadores e Monocomandos",
  "Instalação de Caixas d'Água e Pressurizadores",
  "Tubulações em Cobre, PVC, PPR e Termofusão",
  "Manutenção Hidráulica Preventiva e Corretiva",
