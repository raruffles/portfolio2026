                <span class="whitespace-nowrap">Nossos Serviços</span>
              </a>
            </div>

            <!-- Micro Trust Badges com Bootstrap Icons -->
            <div class="flex items-center gap-5 text-[15px] sm:text-[16px] font-bold text-slate-700">
              <span class="flex items-center gap-2 whitespace-nowrap">
                <i class="bi bi-clock-history text-emerald-600 text-base flex-shrink-0" aria-hidden="true"></i>
