---
// TF Serviços Técnicos - Landing Page de Alta Conversão (CRO)
// Framework: Astro + Tailwind CSS + Lucide SVG Icons
// Foco: Geração de Leads via WhatsApp & Atendimento Emergencial

const whatsappNumber = "5511978466278";
const phoneFormatted = "(11) 97846-6278";

// Função geradora de link WhatsApp com tracking de origem
const createWaLink = (origem: string = "site") => {
  const mensagem = `Olá, vim através do site da TF Serviços Técnicos (${origem}) e preciso de um orçamento emergencial. Pode me ajudar?`;
  return `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(mensagem)}`;
};

const defaultWaLink = createWaLink("hero");

// Dados dos 6 Principais Serviços
const servicos = [
  {
    id: "eletrica",
    titulo: "Elétrica",
    descricao: "Instalações novas, troca de disjuntores, fiação, reparos de curto-circuito e iluminação técnica.",
