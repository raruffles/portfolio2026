---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TF Serviços Técnicos | Atendimento Emergencial em SP e Região</title>
    <meta
      name="description"
      content="Serviços técnicos emergenciais em São Paulo: Elétrica, Hidráulica, Marido de Aluguel, Desentupimento, Pedreiro e Telhadista. Atendimento em até 40 minutos com garantia!"
    />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0B0C10" />

    <!-- Open Graph / Redes Sociais -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="TF Serviços Técnicos | Emergência em São Paulo" />
    <meta
      property="og:description"
      content="Chegamos em até 40 minutos. Elétrica, hidráulica, reformas e reparos com garantia e nota fiscal."
    />
    <meta property="og:url" content="https://tfservicostecnicos.com.br/" />

    <!-- Google Fonts: Inter & Montserrat -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Montserrat:wght@700;800;900&display=swap"
      rel="stylesheet"
    />

    <!-- Tailwind CSS (CDN para execução imediata e portabilidade universal) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              sans: ["Inter", "sans-serif"],
              heading: ["Montserrat", "sans-serif"],
            },
            colors: {
              brand: {
                black: "#0B0C10",
                dark: "#14161D",
                card: "#1C1F2B",
                yellow: "#F59E0B",
                yellowHover: "#D97706",
                yellowLight: "#FEF3C7",
                gray: "#2A2E3D",
                muted: "#94A3B8",
                green: "#22C55E",
                greenHover: "#16A34A",
              },
            },
            keyframes: {
              pulseGlow: {
                "0%, 100%": { boxShadow: "0 0 20px rgba(245, 158, 11, 0.4)" },
                "50%": { boxShadow: "0 0 35px rgba(245, 158, 11, 0.85)" },
              },
              pulseGreen: {
                "0%, 100%": { boxShadow: "0 0 15px rgba(34, 197, 94, 0.4)" },
                "50%": { boxShadow: "0 0 30px rgba(34, 197, 94, 0.9)" },
              },
            },
            animation: {
              glow: "pulseGlow 2.5s infinite",
              glowGreen: "pulseGreen 2s infinite",
            },
          },
        },
      };
    </script>

    <style>
      /* Suavização de renderização de fontes */
      body {
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        font-family: "Inter", sans-serif;
      }
    </style>
  </head>

  <body class="bg-slate-50 text-slate-800 antialiased selection:bg-amber-400 selection:text-black">
    <!-- ========================================== -->
    <!-- 1. HEADER (Fixo / Sticky)                  -->
    <!-- ========================================== -->
    <header
      id="header"
      class="sticky top-0 z-50 w-full bg-neutral-950/95 backdrop-blur-md border-b border-neutral-800 transition-all duration-300"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-20">
          <!-- Logo com Identidade Técnica -->
          <a href="#inicio" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-amber-400 rounded-lg p-1">
            <div
              class="w-11 h-11 rounded-xl bg-gradient-to-br from-amber-400 to-amber-600 flex items-center justify-center text-neutral-950 shadow-lg shadow-amber-500/20 group-hover:scale-105 transition-transform"
            >
              <!-- Ícone Raio + Ferramenta (Lucide Zap) -->
              <svg
                class="w-6 h-6 stroke-[2.5]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
            </div>
            <div class="flex flex-col">
              <span class="font-heading font-black text-xl tracking-tight text-white leading-none">
                TF <span class="text-amber-400">SERVIÇOS</span>
              </span>
              <span class="text-[11px] font-semibold text-neutral-400 uppercase tracking-widest mt-1">
                Técnicos & Manutenção
              </span>
            </div>
          </a>

          <!-- Navegação Desktop -->
          <nav class="hidden md:flex items-center gap-8">
            <a
              href="#inicio"
              class="text-sm font-semibold text-neutral-300 hover:text-amber-400 transition-colors"
            >
              Início
            </a>
            <a
              href="#servicos"
              class="text-sm font-semibold text-neutral-300 hover:text-amber-400 transition-colors"
            >
              Serviços
            </a>
            <a
              href="#detalhes-eletrica"
              class="text-sm font-semibold text-neutral-300 hover:text-amber-400 transition-colors"
            >
              Especialidades
            </a>
            <a
              href="#quem-somos"
              class="text-sm font-semibold text-neutral-300 hover:text-amber-400 transition-colors"
            >
              Quem Somos
            </a>
            <a
              href="#atendimento"
              class="text-sm font-semibold text-neutral-300 hover:text-amber-400 transition-colors"
            >
              Atendimento
            </a>
            <a
              href="#contato"
              class="text-sm font-semibold text-neutral-300 hover:text-amber-400 transition-colors"
            >
              Fale Conosco
            </a>
          </nav>

          <!-- Botão CTA Header (WhatsApp) -->
          <div class="hidden sm:flex items-center gap-4">
            <a
              href={createWaLink("header_cta")}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2.5 px-5 py-2.5 rounded-xl text-sm font-bold bg-emerald-500 hover:bg-emerald-600 text-white shadow-lg shadow-emerald-500/25 transition-all transform hover:scale-105 active:scale-95"
            >
              <!-- Ícone WhatsApp Lucide MessageCircle -->
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path
                  d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2zm0 18.09c-1.49 0-2.95-.4-4.23-1.16l-.3-.18-3.14.82.84-3.06-.2-.31a8.13 8.13 0 01-1.26-4.29c0-4.52 3.68-8.2 8.2-8.2 2.19 0 4.25.85 5.8 2.4 1.55 1.55 2.4 3.61 2.4 5.8 0 4.52-3.68 8.18-8.11 8.18zm4.49-6.13c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.44.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.44-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.44.06-.66.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.12-.22-.19-.47-.31z"
                ></path>
              </svg>
              <span>Solicitar Serviço</span>
            </a>
          </div>

          <!-- Botão Menu Mobile -->
          <div class="flex md:hidden">
            <button
              id="mobile-menu-btn"
              type="button"
              class="p-2.5 rounded-lg text-neutral-300 hover:text-white hover:bg-neutral-800 focus:outline-none focus:ring-2 focus:ring-amber-400"
              aria-label="Abrir Menu"
            >
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
            </button>
          </div>
        </div>

        <!-- Menu Mobile Drawer -->
        <div id="mobile-menu" class="hidden md:hidden pb-6 pt-2 border-t border-neutral-800">
          <div class="flex flex-col space-y-3">
            <a href="#inicio" class="text-neutral-200 hover:text-amber-400 px-2 py-1 font-medium">Início</a>
            <a href="#servicos" class="text-neutral-200 hover:text-amber-400 px-2 py-1 font-medium">Serviços</a>
            <a href="#detalhes-eletrica" class="text-neutral-200 hover:text-amber-400 px-2 py-1 font-medium">Especialidades</a>
            <a href="#quem-somos" class="text-neutral-200 hover:text-amber-400 px-2 py-1 font-medium">Quem Somos</a>
            <a href="#atendimento" class="text-neutral-200 hover:text-amber-400 px-2 py-1 font-medium">Atendimento</a>
            <a href="#contato" class="text-neutral-200 hover:text-amber-400 px-2 py-1 font-medium">Fale Conosco</a>
            <a
              href={createWaLink("mobile_menu")}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-2 flex items-center justify-center gap-2 py-3 rounded-xl font-bold bg-emerald-500 text-white"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2zm0 18.09c-1.49 0-2.95-.4-4.23-1.16l-.3-.18-3.14.82.84-3.06-.2-.31a8.13 8.13 0 01-1.26-4.29c0-4.52 3.68-8.2 8.2-8.2 2.19 0 4.25.85 5.8 2.4 1.55 1.55 2.4 3.61 2.4 5.8 0 4.52-3.68 8.18-8.11 8.18zm4.49-6.13c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.44.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.44-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.44.06-.66.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.12-.22-.19-.47-.31z" />
              </svg>
              Solicitar Serviço via WhatsApp
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- ========================================== -->
    <!-- 2. HERO SECTION (Acima da Dobra - Foco CRO)-->
    <!-- ========================================== -->
    <section id="inicio" class="relative bg-neutral-950 text-white pt-12 pb-20 lg:pt-20 lg:pb-28 overflow-hidden">
      <!-- Imagem de Fundo com Overlay Escuro High-Tech -->
      <div class="absolute inset-0 z-0">
        <img
          src="https://images.unsplash.com/photo-1621905251189-08b45d6a269e?auto=format&fit=crop&w=2000&q=80"
          alt="Técnico Especialista em Atendimento"
          class="w-full h-full object-cover object-center opacity-20 filter grayscale contrast-125"
          loading="eager"
        />
        <!-- Gradientes para legibilidade absoluta do texto -->
        <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/90 to-neutral-950/75"></div>
        <div class="absolute -top-40 -right-40 w-96 h-96 bg-amber-500/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
      </div>

      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Tag de Urgência & Cobertura -->
        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-neutral-900/90 border border-amber-400/30 text-amber-300 text-xs sm:text-sm font-semibold mb-6 shadow-md backdrop-blur">
          <span class="flex h-2.5 w-2.5 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-amber-500"></span>
          </span>
          Plantão Emergencial 24h em São Paulo e Região Metropolitana
        </div>

        <!-- H1 Principal -->
        <h1 class="font-heading font-black text-3xl sm:text-5xl lg:text-6xl tracking-tight text-white max-w-4xl leading-[1.15]">
          SERVIÇOS TÉCNICOS <br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-yellow-300 to-amber-500">
            EMERGENCIAIS
          </span>{" "}
          EM SÃO PAULO E REGIÃO
        </h1>

        <!-- H2 / Subtítulo de Apoio -->
        <p class="mt-6 text-lg sm:text-xl text-neutral-300 max-w-2xl leading-relaxed">
          Atendimento emergencial, pagamento facilitado e garantia de serviço resolvido! Técnicos prontos para chegar na sua casa ou empresa com agilidade.
        </p>

        <!-- Bloco de Destaque para o SAC (Telefone & WhatsApp) -->
        <div class="mt-8 p-4 sm:p-5 rounded-2xl bg-neutral-900/80 border border-neutral-800 backdrop-blur-md max-w-xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div class="flex items-center gap-3.5">
            <div class="w-12 h-12 rounded-xl bg-amber-400/10 border border-amber-400/30 flex items-center justify-center text-amber-400">
              <svg class="w-6 h-6 stroke-current" fill="none" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
            </div>
            <div>
              <span class="text-xs uppercase font-bold tracking-wider text-neutral-400 block">
                Central de Atendimento 24h
              </span>
              <a
                href="tel:11978466278"
                class="text-2xl sm:text-3xl font-heading font-black text-amber-400 hover:text-amber-300 transition-colors tracking-tight"
              >
                {phoneFormatted}
              </a>
            </div>
          </div>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Técnicos Livres Agora
          </span>
        </div>

        <!-- Botão CTA Principal Gigante e Pulsante -->
        <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-4 max-w-xl">
          <a
            href={createWaLink("hero_cta_principal")}
            target="_blank"
            rel="noopener noreferrer"
            class="relative group flex items-center justify-center gap-3 px-8 py-5 rounded-2xl font-heading font-black text-lg sm:text-xl text-neutral-950 bg-gradient-to-r from-amber-400 via-yellow-400 to-amber-500 hover:from-amber-300 hover:to-yellow-400 shadow-[0_0_35px_rgba(245,158,11,0.5)] hover:shadow-[0_0_50px_rgba(245,158,11,0.8)] transition-all duration-300 transform hover:-translate-y-1 active:translate-y-0 text-center"
          >
