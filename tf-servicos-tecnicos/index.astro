      <a href="#inicio" class="flex items-center gap-2.5 sm:gap-3 flex-shrink-0 mr-2 sm:mr-4 xl:mr-10 group" aria-label="Vivaz Serviços e Soluções - Página Inicial">
        <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-slate-950 flex items-center justify-center p-1.5 shadow-sm group-hover:scale-105 transition-transform flex-shrink-0 border border-slate-800" aria-hidden="true">
          <img src="vivaz/imgs/logo-vivaz-white.png" alt="Logo Vivaz" class="w-full h-full object-contain" />
        </div>
        <div class="flex flex-col">
          <span class="font-black text-[15px] sm:text-[17px] tracking-tight text-slate-950 uppercase leading-none whitespace-nowrap">Vivaz</span>
          <span class="text-[12px] sm:text-[13px] text-slate-600 font-bold leading-tight whitespace-nowrap">Serviços e Soluções</span>
