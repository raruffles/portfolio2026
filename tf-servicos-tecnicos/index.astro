<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Vivaz Serviços e Soluções | Excelência em Elétrica, Hidráulica e Obras em SJC e Vale do Paraíba</title>
  <meta name="description" content="Serviços técnicos e reformas de excelência da Vivaz Serviços e Soluções em São José dos Campos, Jacareí, Taubaté e Vale do Paraíba. Elétrica, hidráulica, pintura, alvenaria, drywall e mais." />
  
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  
  <!-- Bootstrap Icons CDN Oficial -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  
  <style>
    /* Regras Globais de Acessibilidade e Legibilidade */
    html {
      font-size: 16px;
    }
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: #FFFFFF;
      color: #0F172A;
      font-size: 16px;
      line-height: 1.75;
      overflow-x: hidden;
      text-rendering: optimizeLegibility;
      -webkit-font-smoothing: antialiased;
    }

    /* Recorte dinâmico no Hero com entalhe em V sob os botões centrais */
    .hero-cutout-banner {
      clip-path: polygon(
        0% 0%,
        calc(50% - 160px) 0%,
        50% 32px,
        calc(50% + 160px) 0%,
        100% 0%,
        100% 100%,
        0% 100%
      );
    }
    @media (max-width: 640px) {
      .hero-cutout-banner {
        clip-path: none;
        border-radius: 24px;
      }
    }

    /* Recorte dinâmico Bento Escuro (Why choose us / FAQ) */
    .bento-cutout-top {
      clip-path: polygon(
        0% 24px,
        calc(50% - 160px) 24px,
        calc(50% - 120px) 0px,
        calc(50% + 120px) 0px,
        calc(50% + 160px) 24px,
        100% 24px,
        100% 100%,
        0% 100%
      );
    }
    @media (max-width: 640px) {
      .bento-cutout-top {
        clip-path: none;
        border-radius: 32px;
      }
    }

    /* Anel de foco acessível para teclado (WCAG 2.4.7) */
    a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible {
      outline: 4px solid #F59E0B !important;
      outline-offset: 3px !important;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-8px); }
    }
    .animate-float {
      animation: float 4s ease-in-out infinite;
    }
    .animate-float-delayed {
      animation: float 4.5s ease-in-out 1.5s infinite;
    }

    @keyframes pulseSubtle {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.9; transform: scale(1.02); }
    }
    .animate-pulse-subtle {
      animation: pulseSubtle 2.5s infinite ease-in-out;
    }
  </style>
</head>
<body class="bg-white text-slate-900 antialiased selection:bg-amber-200 selection:text-slate-950">

  <!-- Acessibilidade: Link para pular direto ao conteúdo principal -->
  <a href="#conteudo-principal" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-6 focus:py-3 focus:bg-amber-400 focus:text-slate-950 focus:font-extrabold focus:rounded-xl focus:shadow-2xl">
    Pular para o conteúdo principal
