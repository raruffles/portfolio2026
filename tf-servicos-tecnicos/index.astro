      <!-- Desktop Nav Links (5 links estratégicos, espaçamento amplo, sem apertar o logo) -->
      <nav class="hidden lg:flex items-center gap-6 xl:gap-8 text-[16px] font-extrabold text-slate-700" aria-label="Navegação Principal">
        <a href="#inicio" class="hover:text-amber-600 transition-colors py-2 whitespace-nowrap">Início</a>
        <a href="#quem-somos" class="hover:text-amber-600 transition-colors py-2 whitespace-nowrap">Quem Somos</a>
        <a href="#servicos" class="hover:text-amber-600 transition-colors py-2 whitespace-nowrap">Serviços</a>
        <a href="#portfolio" class="hover:text-amber-600 transition-colors py-2 whitespace-nowrap">Portfólio</a>
        <a href="#contato" class="hover:text-amber-600 transition-colors py-2 whitespace-nowrap">Contato</a>
      </nav>

      <!-- Right Action CTA (Mínimo touch target 48px, alto contraste preto/âmbar no hover) -->
      <div class="flex items-center gap-2 sm:gap-4 flex-shrink-0 ml-auto lg:ml-0">
        <a href={`tel:${whatsappNumber.substring(2)}`} class="hidden xl:flex items-center gap-2 text-[16px] font-extrabold text-slate-900 hover:text-amber-700 transition-colors px-2 py-2 min-h-[48px] rounded-xl whitespace-nowrap" aria-label="Ligue para nossa central">
          <i class="bi bi-telephone-fill text-amber-600 text-base" aria-hidden="true"></i>
          <span class="whitespace-nowrap">{phoneFormatted}</span>
        </a>

        <!-- Botão com Contraste Extremo no Hover -->
        <a href={defaultWaLink} target="_blank" rel="noopener noreferrer" class="bg-amber-400 hover:bg-slate-950 text-slate-950 hover:text-amber-400 border-2 border-amber-400 hover:border-slate-950 font-black text-[14px] sm:text-[16px] px-3.5 sm:px-6 py-2 sm:py-3 min-h-[44px] sm:min-h-[48px] rounded-full shadow-md hover:shadow-xl active:scale-95 transition-all duration-200 flex items-center justify-center gap-1.5 sm:gap-2 whitespace-nowrap" aria-label="Solicitar Orçamento via WhatsApp">
          <i class="bi bi-whatsapp text-[16px] sm:text-[18px] flex-shrink-0"></i>
          <span class="hidden sm:inline whitespace-nowrap">Solicitar Orçamento</span>
          <span class="sm:hidden whitespace-nowrap">Orçamento</span>
        </a>
      </div>
    </div>
  </header>

  <!-- ========================================================================= -->
  <!-- 2. HERO SECTION (Título na Esquerda, Texto de Alta Conversão na Direita) -->
  <!-- ========================================================================= -->
  <main id="conteudo-principal">
    <section id="inicio" class="relative pt-28 sm:pt-36 md:pt-40 pb-20 md:pb-28 overflow-hidden" aria-labelledby="hero-heading">
      <div class="max-w-7xl mx-auto px-4 md:px-8">
        
