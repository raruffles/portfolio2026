{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/paulo", "destination": "/catalogo?vendedor=paulo", "permanent": false },
    { "source": "/elaine", "destination": "/catalogo?vendedor=elaine", "permanent": false },
    { "source": "/paulo-cotacao", "destination": "/vendedor?vendedor=paulo", "permanent": false },
    { "source": "/elaine-cotacao", "destination": "/vendedor?vendedor=elaine", "permanent": false }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/catalogo", "destination": "/catalogo.html" },
    { "source": "/tabela", "destination": "/catalogo.html" },
    { "source": "/precos", "destination": "/catalogo.html" },
    { "source": "/vendedor", "destination": "/vendedor.html" },
    { "source": "/representante", "destination": "/vendedor.html" },
    { "source": "/cotacao", "destination": "/vendedor.html" },
    { "source": "/sem-preco", "destination": "/vendedor.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
